# Set a persistent, private value before running with DEBUG=False.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ORS_API_KEY=
# Per-process admitted planners. Larger limits require CPU/provider load evidence.
# Saturation returns PLANNING_BUSY/503 with Retry-After rather than queueing.
FUEL_PLANNING_CAPACITY=6
FUEL_ADMISSION_WAIT_SECONDS=4
# Per-process fixed-window quota, by REMOTE_ADDR normalized by the trusted server.
# Includes trip submissions, saved results and map shells; health is exempt.
FUEL_API_RATE_REQUESTS=120
FUEL_API_RATE_WINDOW_SECONDS=60
FUEL_API_RATE_MAX_CALLERS=10000
# Bounded directed-matrix search is on by default; set 0 for corridor-only fallback.
FUEL_MATRIX_GRAPH=1
# Start with the hosted directed matrix so fresh trips retain a repair call.
# Set 0 to use the older baseline-directions-first path.
FUEL_MATRIX_FIRST=1
# Bump to invalidate the six-hour local matrix cache after a known road-data change.
FUEL_MATRIX_CACHE_VERSION=v1
# Optional regional OSRM matrix accelerator. Set all three for a pinned graph;
# the hosted ORS matrix remains the fallback outside these bounds.
FUEL_LOCAL_OSRM_URL=
FUEL_LOCAL_OSRM_VERSION=
# west,south,east,north in WGS84 decimal degrees, inside the built extract.
FUEL_LOCAL_OSRM_BOUNDS=
# Optional nationwide Valhalla graph. The matching complete station-edge marker
# must exist before the CSV-wide refinement is enabled.
FUEL_NATIONAL_VALHALLA_URL=
FUEL_NATIONAL_VALHALLA_VERSION=
# Optional override for the stable-point road checkpoint. The app uses
# station_edges_v2_live.db when present, otherwise the legacy checkpoint.
FUEL_STATION_ROAD_DATABASE=
# Opt-in hosted plans to refine with only completed local road-source rows.
# Final ORS directions still verify every accepted improvement.
FUEL_PARTIAL_ROAD_REFINER=0
# Experimental bounded local-first planning; requires the partial refiner.
FUEL_PARTIAL_ROAD_LOCAL_FIRST=0
# Experimental concurrent hosted/local candidates with one shared request
# budget. A local candidate is compared only after hosted-profile verification.
FUEL_PARTIAL_ROAD_PORTFOLIO=0
# Local-only baseline, matrix, national search and final directions. Enable only
# after the station-edge completion marker matches the CSV and road versions.
FUEL_NATIONAL_LOCAL_ROUTER=0
